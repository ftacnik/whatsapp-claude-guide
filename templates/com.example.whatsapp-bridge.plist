<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The WhatsApp bridge as a service: starts at login and restarts if it dies.
     Replace YOU with your macOS user name. Log: ~/Library/Logs/whatsapp-bridge.log -->
<dict>
  <key>Label</key><string>com.example.whatsapp-bridge</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/YOU/.local/bin/whatsapp-bridge-run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string></dict>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/whatsapp-bridge.err</string>
</dict>
</plist>
